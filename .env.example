# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs session cookies -- use a long random value, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
# The /demo mode is unauthenticated (anyone can draw winners and reset its
# state), so it is disabled in production unless this is set to "true".
# Always on outside production.
ENABLE_DEMO=true

# Twitch (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional allowlist of Twitch user ids allowed to register a channel on
# /admin. Comma separated. Leave empty to let any Twitch account sign up.
ALLOWED_STREAMER_TWITCH_IDS=
# The app-wide chat bot: the one Twitch account that posts in EVERY
# registered streamer's channel (like Nightbot always being @nightbot).
# Run `node scripts/get-bot-token.mjs` and log in as the bot account --
# that grants the app the `user:bot` scope and prints the id below.
# Use an account that is NOT a broadcaster you run giveaways in: Twitch
# withholds the chat bot badge when bot and broadcaster are the same.
TWITCH_BOT_USER_ID=
# Shared secret used to verify EventSub webhook signatures
TWITCH_EVENTSUB_SECRET=
# Only for local development: Twitch delivers chat events to public https
# URLs only, so point this at a tunnel to your dev server, e.g.
# `cloudflared tunnel --url http://localhost:3000`. The login flow keeps
# using NEXT_PUBLIC_APP_URL (http://localhost:3000), which is what the
# Twitch app has registered as an OAuth redirect. Leave empty everywhere
# else -- deployments are reachable under their own URL.
# Careful: connecting the bot with this set moves that channel's chat to
# your machine until you reconnect from the deployed app. Only ever do this
# with your own test channel.
EVENTSUB_PUBLIC_URL=

# osu! (https://osu.ppy.sh/home/account/edit#oauth)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Guards the scheduled osu! stats refresh (see vercel.json). Any long random
# value; Vercel sends it as `Authorization: Bearer <CRON_SECRET>` when it runs
# the cron. Without it the route answers 503 and nothing is refreshed.
CRON_SECRET=
